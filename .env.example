# Fathom configuration. Every data feed is public: NO API keys or wallets are needed to record or serve data.
# Copy to .env (Python reads it automatically). Values below are the defaults.

# --- Recorder / API host (the always-on machine) ---
FATHOM_DB=./data/fathom.db
FATHOM_EXPORT_DIR=./data/export

# Strike mainnet (testnet: https://api-v2-testnet.strikefinance.org / wss://api-v2-testnet.strikefinance.org)
STRIKE_REST=https://api.strikefinance.org
STRIKE_WS=wss://api.strikefinance.org

# Benchmarks
BINANCE_MARKET=auto
BINANCE_RESYNC_SECONDS=900
HYPERLIQUID_WS=wss://api.hyperliquid.xyz/ws
CHECKPOINT_SECONDS=600

# --- API ---
API_HOST=0.0.0.0
API_PORT=8000
# Comma-separated origins allowed to call the API from a browser. Set to your frontend URL in production.
CORS_ORIGINS=*

# Optional: where recorder alerts are POSTed (Discord/Slack webhook). Alerts are stored and served at /api/alerts either way.
ALERT_STALE_SECONDS=60
ALERT_WEBHOOK_URL=

# --- Frontend (web/.env.local) ---
# NEXT_PUBLIC_API_URL=https://<your-public-api-host>

# ============ YOU SUPPLY THESE (empty = not set yet). Nothing below is a secret the recorder needs. ============
# Everything the product reads is public market data, so the recorder and API run with the values above.

# --- 1. Public deployment (needed for the "live scorecard link" in the submission) ---
# HTTPS URL of the API once deployed. Put the SAME value in web/.env.local as NEXT_PUBLIC_API_URL.
PUBLIC_API_URL=
# HTTPS URL of the deployed frontend. Also set CORS_ORIGINS (above) to this value instead of *.
FRONTEND_URL=

# --- 2. Always-on recorder host (the laptop sleeping caused 22 h of permanent gaps) ---
# A VPS with Python 3.11. deploy/fathom-recorder.service and deploy/fathom-api.service run on it.
VPS_HOST=
VPS_USER=
# Optional second recorder on another host (PRD stretch item, removes the single point of failure).
VPS2_HOST=
VPS2_USER=

# --- 3. Submission package ---
GITHUB_REPO_URL=
DEMO_VIDEO_URL=
SUBMISSION_FORM_URL=

# --- 4. OPTIONAL, only if you decide to add an on-chain piece (not in the PRD, which says no wallets) ---
# The only real on-chain feature that fits Fathom: publish a hash of each day's dataset to Cardano so the
# recorded history cannot be quietly edited later. It needs a funded wallet, so these are SECRETS:
# keep them out of git (.env is already git-ignored) and never paste them into chat or the frontend.
CARDANO_NETWORK=
BLOCKFROST_PROJECT_ID=
ANCHOR_WALLET_ADDRESS=
ANCHOR_SIGNING_KEY_PATH=
